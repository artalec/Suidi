[USB_Install.ntx86]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install.ntx86.Services]
Include=winusb.inf
AddService=WinUSB,0x00000002,WinUSB_ServiceInstall

[USB_Install.ntx86.HW]
AddReg=Dev_AddReg

[USB_Install.ntamd64]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install.ntamd64.Services]
Include=winusb.inf
AddService=WinUSB,0x00000002,WinUSB_ServiceInstall

[USB_Install.ntamd64.HW]
AddReg=Dev_AddReg

[USB_Install.ntarm64]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install.ntarm64.Services]
Include=winusb.inf
AddService=WinUSB,0x00000002,WinUSB_ServiceInstall

[USB_Install.ntarm64.HW]
AddReg=Dev_AddReg

[WinUSB_ServiceInstall]
DisplayName    = %WinUSB_SvcDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\WinUSB.sys

; CRITICAL: Sunlite Suite opens the device through this interface GUID.
; Do not change it.
[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs, 0x10000,%Siudi.GUID%
; --- keep the interface from being power-managed / suspended ---
HKR,,EnhancedPowerManagementEnabled,0x00010001,0
HKR,,SelectiveSuspendEnabled,0x00010001,0
HKR,,AllowIdleIrpInD3,0x00010001,0
HKR,,DeviceResetOnResume,0x00010001,0

